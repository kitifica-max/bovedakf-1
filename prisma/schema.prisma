generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  companyName  String?
  // Captured at signup — lightweight profiling, not required to use the product.
  industry     String?
  bottleneck   String?
  // In-app micro-survey shown once on the dashboard (answered or dismissed, whichever first).
  surveyAnswer      String?
  surveyDismissedAt DateTime?
  // TOTP 2FA. totpSecret is AES-256-GCM encrypted at rest (encryptAtRest),
  // never stored or logged in plaintext. Set as soon as enrollment starts;
  // totpEnabled only flips true once the user confirms a valid code, so an
  // abandoned enrollment never affects login. totpBackupCodes is a JSON
  // array of { hash, salt, usedAt } — single-use recovery codes for when
  // the authenticator device is lost.
  totpSecret      String?
  totpEnabled     Boolean  @default(false)
  totpBackupCodes Json?
  passwordHash String
  passwordSalt String
  createdAt    DateTime @default(now())
  vaults       Vault[]
  // Fields below exist only to satisfy @auth/prisma-adapter's expected User
  // shape (Passkey/WebAuthn login). Unused elsewhere in the app.
  name          String?
  image         String?
  emailVerified DateTime?
  accounts      Account[]
  sessions      Session[]
  authenticators Authenticator[]
}

// Standard Auth.js Prisma adapter schema, required for the Passkey (WebAuthn)
// provider — see https://authjs.dev/getting-started/authentication/webauthn.
// Session/VerificationToken are unused at runtime (this app uses JWT
// sessions and no email provider) but the adapter's type surface expects
// them to exist.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// One row per registered passkey (a device can hold several; a user can
// register several devices).
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  createdAt            DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model Vault {
  id          String       @id @default(cuid())
  name        String
  ownerId     String
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  credentials Credential[]
  createdAt   DateTime     @default(now())
}

model Credential {
  id            String      @id @default(cuid())
  vaultId       String
  vault         Vault       @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  service       String
  username      String
  // AES-256-GCM at rest, base64: iv(12) + tag(16) + ciphertext, key = env ENCRYPTION_KEY
  encryptedData String
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  shareLinks    ShareLink[]
}

enum LinkPermission {
  READ
  DOWNLOAD
}

model ShareLink {
  id           String         @id @default(cuid())
  // Unguessable lookup id (32 random bytes, base64url). Safe to expose in
  // the URL path: the actual decryption key never touches the server or DB
  // — it lives only in the URL fragment the recipient's browser holds.
  publicId     String         @unique
  credentialId String
  credential   Credential     @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  // Snapshot of the credential, re-encrypted with a one-time key generated
  // at share time. Same base64 layout as Credential.encryptedData.
  payload      String
  permission   LinkPermission @default(READ)
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime       @default(now())
  accessLogs   AuditLog[]
}

model AuditLog {
  id          String     @id @default(cuid())
  shareLinkId String?
  shareLink   ShareLink? @relation(fields: [shareLinkId], references: [id], onDelete: SetNull)
  vaultId     String?
  action      String
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime   @default(now())
}
