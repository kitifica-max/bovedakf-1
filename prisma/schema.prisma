generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  companyName  String?
  // Captured at signup — lightweight profiling, not required to use the product.
  // "Product radar": which task costs them time, and how they solve it today.
  industry        String?
  bottleneck      String?
  currentSolution String?
  // In-app micro-survey shown once on the dashboard (answered or dismissed, whichever first).
  // Free text: another team task they'd want automated.
  surveyAnswer      String?
  surveyDismissedAt DateTime?
  // TOTP 2FA. totpSecret is AES-256-GCM encrypted at rest (encryptAtRest),
  // never stored or logged in plaintext. Set as soon as enrollment starts;
  // totpEnabled only flips true once the user confirms a valid code, so an
  // abandoned enrollment never affects login. totpBackupCodes is a JSON
  // array of { hash, salt, usedAt } — single-use recovery codes for when
  // the authenticator device is lost.
  totpSecret      String?
  totpEnabled     Boolean  @default(false)
  totpBackupCodes Json?
  passwordHash String
  passwordSalt String
  createdAt    DateTime @default(now())
  vaults       Vault[]
  memberships  VaultMember[]
  sentInvites  VaultInvite[]
  // Fields below exist only to satisfy @auth/prisma-adapter's expected User
  // shape (Passkey/WebAuthn login). Unused elsewhere in the app.
  name          String?
  image         String?
  emailVerified DateTime?
  accounts      Account[]
  sessions      Session[]
  authenticators Authenticator[]
}

// Standard Auth.js Prisma adapter schema, required for the Passkey (WebAuthn)
// provider — see https://authjs.dev/getting-started/authentication/webauthn.
// Session/VerificationToken are unused at runtime (this app uses JWT
// sessions and no email provider) but the adapter's type surface expects
// them to exist.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// One row per registered passkey (a device can hold several; a user can
// register several devices).
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  createdAt            DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model Vault {
  id          String       @id @default(cuid())
  name        String
  ownerId     String
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  credentials Credential[]
  members     VaultMember[]
  invites     VaultInvite[]
  createdAt   DateTime     @default(now())
}

model Credential {
  id            String      @id @default(cuid())
  vaultId       String
  vault         Vault       @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  service       String
  username      String
  // AES-256-GCM at rest, base64: iv(12) + tag(16) + ciphertext, key = env ENCRYPTION_KEY
  encryptedData String
  notes         String?
  // Whether this credential is accessible to AI agents via MCP.
  aiAccessible  Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  shareLinks    ShareLink[]
}

enum LinkPermission {
  READ
  DOWNLOAD
}

enum VaultRole {
  OWNER
  EDITOR
  VIEWER
}

// Accepted membership. The vault owner also gets an OWNER row here (created
// alongside the vault) so "which vaults can I open" is a single query.
model VaultMember {
  id        String    @id @default(cuid())
  vaultId   String
  vault     Vault     @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      VaultRole @default(VIEWER)
  createdAt DateTime  @default(now())

  @@unique([vaultId, userId])
}

// Pending invite. `token` goes in the /invite/<token> URL. Deleted-by-cascade
// with the vault; kept after acceptance (acceptedAt set) for the audit trail.
model VaultInvite {
  id          String    @id @default(cuid())
  vaultId     String
  vault       Vault     @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  email       String
  role        VaultRole @default(VIEWER)
  token       String    @unique
  invitedById String
  invitedBy   User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
}

model ShareLink {
  id           String         @id @default(cuid())
  // Unguessable lookup id (32 random bytes, base64url). Safe to expose in
  // the URL path: the actual decryption key never touches the server or DB
  // — it lives only in the URL fragment the recipient's browser holds.
  publicId     String         @unique
  credentialId String
  credential   Credential     @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  // Snapshot of the credential, re-encrypted with a one-time key generated
  // at share time. Same base64 layout as Credential.encryptedData.
  payload      String
  permission   LinkPermission @default(READ)
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime       @default(now())
  accessLogs   AuditLog[]
}

model AuditLog {
  id          String     @id @default(cuid())
  shareLinkId String?
  shareLink   ShareLink? @relation(fields: [shareLinkId], references: [id], onDelete: SetNull)
  vaultId     String?
  action      String
  // Email of the signed-in team member who caused the event (create/revoke
  // share link, view credential). Null for anonymous share-link recipients.
  actorEmail  String?
  // Snapshot of the credential's service name at the time of the event —
  // not a live join, so the row still names the credential even after the
  // share link is revoked/expired or the credential itself is deleted.
  credentialService String?
  // Agent name for AI access events (e.g. "claude-code").
  agentName   String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime   @default(now())
}
