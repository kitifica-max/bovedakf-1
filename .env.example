# PostgreSQL connection string (Supabase or any Postgres)
# Format: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# NextAuth secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# AES-256-GCM key for encrypting credentials and TOTP secrets at rest.
# Must be exactly 64 hex characters (32 bytes).
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# Public URL of the application (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated admin emails — accounts that can access /admin
ADMIN_EMAILS=

# Fixes Server Action IDs across deploys and serverless instances.
# Without this, each deploy invalidates open browser tabs.
# Generate: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Email delivery via Resend (https://resend.com)
# Required for: invite emails, verification emails, password reset
RESEND_API_KEY=

# Rate limiting via Upstash Redis (https://console.upstash.com)
# Optional — falls back to in-memory per-instance counter (dev only, not for production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
